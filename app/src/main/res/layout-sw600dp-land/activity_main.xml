<?xml version="1.0" encoding="utf-8"?>
<!--
    平板横屏专用主框架（仅 sw>=600dp 且横屏生效，手机横屏/所有竖屏仍走 layout/activity_main.xml）
    结构：左侧固定导航栏 + 右侧内容区
    说明：bottom_nav 仅保留给 ViewBinding/原有逻辑使用（横屏下隐藏），不改动原有导航功能
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/skin_page_bg"
    android:orientation="horizontal"
    tools:context=".ui.activity.MainActivity">

    <!-- ===== 左侧固定侧边导航：与手机版底部导航一致（首页 / 直播 / 记录 / 我的） ===== -->
    <LinearLayout
        android:id="@+id/side_nav"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:background="?attr/skin_card"
        android:orientation="vertical"
        android:paddingTop="24dp">

        <!-- 首页（当前选中） -->
        <LinearLayout
            android:id="@+id/side_nav_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <View
                android:id="@+id/side_nav_home_bar"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:background="?attr/skin_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="首页"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home" />

                <TextView
                    android:id="@+id/side_nav_home_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="首页"
                    android:textColor="?attr/skin_accent"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 直播：对应原底部导航 navigation_live -->
        <LinearLayout
            android:id="@+id/side_nav_live"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <View
                android:id="@+id/side_nav_live_bar"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="直播"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_live" />

                <TextView
                    android:id="@+id/side_nav_live_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="直播"
                    android:textColor="?attr/skin_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 记录：对应原底部导航 navigation_history -->
        <LinearLayout
            android:id="@+id/side_nav_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <View
                android:id="@+id/side_nav_history_bar"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="记录"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_history_48" />

                <TextView
                    android:id="@+id/side_nav_history_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="记录"
                    android:textColor="?attr/skin_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 我的：对应原底部导航 navigation_my（订阅源、设置等入口都在这里） -->
        <LinearLayout
            android:id="@+id/side_nav_my"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <View
                android:id="@+id/side_nav_my_bar"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="我的"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_my" />

                <TextView
                    android:id="@+id/side_nav_my_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="我的"
                    android:textColor="?attr/skin_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 右侧内容区（保持原有 ViewPager，逻辑不变） ===== -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <!-- 横屏下隐藏原底部导航，仅为兼容原有绑定/逻辑保留 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@drawable/bottom_navigation_item_selector"
        app:itemTextColor="@drawable/bottom_navigation_item_selector"
        app:menu="@menu/main_bottom_navigation" />
</LinearLayout>
