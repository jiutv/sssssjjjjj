<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!--应用的主要色调,actionBar默认使用该颜色,Toolbar导航栏的底色-->
        <item name="colorPrimary">@color/skin_default_accent</item>
        <!--CheckBox,RadioButton,SwitchCompat等一般控件的选中效果默认采用该颜色-->
        <item name="colorAccent">@color/skin_default_accent</item>
        <!--默认window窗口(activity)背景颜色,根据主题修改该属性可 避免某些情况activity跳转/回跳会白屏(出现与主题相反的颜色)-->
        <item name="android:windowBackground">@color/skin_default_page</item>
        <item name="android:forceDarkAllowed">true</item>

        <!-- 皮肤 token 必须与 values/styles.xml 保持一致，否则 API29+ 解析 ?attr/skin_* 会崩溃 -->
        <item name="skin_page">@color/skin_default_page</item>
        <item name="skin_card">@color/skin_default_card</item>
        <item name="skin_card_border">@color/skin_default_border</item>
        <item name="skin_text_primary">@color/skin_default_text</item>
        <item name="skin_text_secondary">@color/skin_default_text_2</item>
        <item name="skin_accent">@color/skin_default_accent</item>
        <item name="skin_accent_soft">@color/skin_default_accent_soft</item>
        <item name="skin_on_accent">@color/skin_default_on_accent</item>
        <item name="skin_glow">@color/skin_default_glow</item>
        <item name="skin_page_bg">@drawable/bg_skin_page_default</item>
        <item name="skin_card_bg">@drawable/bg_large_round_gray</item>
    </style>

    <!-- 浅色皮肤在 API29+ 必须关闭强制深色，否则系统会自动反色 -->
    <style name="SkinMist" parent="AppTheme">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/skin_mist_page</item>
        <item name="skin_page">@color/skin_mist_page</item>
        <item name="skin_page_bg">@drawable/bg_skin_page_mist</item>
        <item name="skin_card">@color/skin_mist_card</item>
        <item name="skin_card_bg">@drawable/bg_skin_card_liquid</item>
        <item name="skin_card_border">@color/skin_mist_border</item>
        <item name="skin_text_primary">@color/skin_mist_text</item>
        <item name="skin_text_secondary">@color/skin_mist_text_2</item>
        <item name="skin_accent">@color/skin_mist_accent</item>
        <item name="skin_accent_soft">@color/skin_mist_accent_soft</item>
        <item name="skin_on_accent">@color/skin_mist_on_accent</item>
        <item name="skin_glow">@color/skin_mist_glow</item>
        <item name="colorAccent">@color/skin_mist_accent</item>
        <item name="colorPrimary">@color/skin_mist_accent</item>
    </style>

    <style name="SkinCream" parent="AppTheme">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/skin_cream_page</item>
        <item name="skin_page">@color/skin_cream_page</item>
        <item name="skin_page_bg">@drawable/bg_skin_page_cream</item>
        <item name="skin_card">@color/skin_cream_card</item>
        <item name="skin_card_bg">@drawable/bg_skin_card_liquid</item>
        <item name="skin_card_border">@color/skin_cream_border</item>
        <item name="skin_text_primary">@color/skin_cream_text</item>
        <item name="skin_text_secondary">@color/skin_cream_text_2</item>
        <item name="skin_accent">@color/skin_cream_accent</item>
        <item name="skin_accent_soft">@color/skin_cream_accent_soft</item>
        <item name="skin_on_accent">@color/skin_cream_on_accent</item>
        <item name="skin_glow">@color/skin_cream_glow</item>
        <item name="colorAccent">@color/skin_cream_accent</item>
        <item name="colorPrimary">@color/skin_cream_accent</item>
    </style>
</resources>