<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mGridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:tv_selectedItemIsCentered="true"
        tools:listitem="@layout/item_grid"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:spanCount="3"
        android:paddingHorizontal="10dp"
        android:paddingTop="@dimen/home_top_overlay_height"
        android:paddingBottom="@dimen/bottom_nav_overlay_padding"
        android:clipToPadding="false" />

    <!-- 筛选：与首页顶部站点胶囊同一套磨砂玻璃样式 -->
    <TextView
        android:id="@+id/btn_filter"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_home_glass_bar"
        android:elevation="4dp"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:text="筛选"
        android:textColor="@color/home_glass_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</RelativeLayout>