<?xml version="1.0" encoding="utf-8"?>
<!--
    液态玻璃推荐首页
    Hero 沉浸式竖版大图 + 横向海报轨 + 继续观看，内容随数据源 / 豆瓣热门自适应
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/skin_page_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ===== Hero 主推：全幅竖版海报，延伸到状态栏下方 ===== -->
            <FrameLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_hero_height">

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/heroPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_scrim" />

                <!-- 顶部渐变：顶部悬浮栏与状态栏图标压在亮色海报上时保持可读 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_home_top_scrim"
                    android:clickable="false"
                    android:focusable="false" />

                <!-- 标题 / 副标题 / 指示器：参考 AVBox，居中展示在海报底部 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:paddingBottom="30dp">

                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="流浪地球 2" />

                    <TextView
                        android:id="@+id/tvHeroDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="6"
                        android:textColor="#D4D4D8"
                        android:textSize="12sp"
                        tools:text="2024 · 科幻 · 蓝光" />

                    <LinearLayout
                        android:id="@+id/heroDots"
                        android:layout_width="wrap_content"
                        android:layout_height="6dp"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal" />

                </LinearLayout>
            </FrameLayout>

            <!-- ===== 热门推荐 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_section_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/home_content_padding">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="热门推荐"
                    android:textColor="?attr/skin_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHotCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/skin_text_secondary"
                    android:textSize="12sp"
                    tools:text="共 20 部" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/home_content_padding"
                android:scrollbars="none"
                tools:listitem="@layout/item_home_poster" />

            <TextView
                android:id="@+id/tvHotEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="@dimen/home_content_padding"
                android:text="暂无推荐内容"
                android:textColor="?attr/skin_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- ===== 继续观看 ===== -->
            <LinearLayout
                android:id="@+id/continueHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_section_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/home_content_padding"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="继续观看"
                    android:textColor="?attr/skin_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/home_content_padding"
                android:scrollbars="none"
                android:visibility="gone"
                tools:listitem="@layout/item_home_continue" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
