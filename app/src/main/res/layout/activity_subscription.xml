<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/skin_page"
    android:orientation="vertical"
    tools:context=".ui.activity.SubscriptionActivity">

    <com.hjq.bar.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="订阅管理"
        app:titleColor="?attr/skin_text_primary"
        app:rightIcon="@drawable/ic_add_24">

        <ImageView
            android:id="@+id/iv_use_tip"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:src="@drawable/ic_use_description_24"
            android:layout_gravity="end|center_vertical"
            android:paddingLeft="20dp"
            android:layout_marginRight="50dp"/>
    </com.hjq.bar.TitleBar>

    <!-- ========== 横向均分 Tab ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- 配置订阅 Tab -->
        <LinearLayout
            android:id="@+id/tab_vod"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tab_vod_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="配置订阅"
                android:textColor="?attr/skin_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/tab_vod_indicator"
                android:layout_width="36dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="4dp"
                android:background="?attr/skin_accent" />
        </LinearLayout>

        <!-- 直播订阅 Tab -->
        <LinearLayout
            android:id="@+id/tab_live"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tab_live_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="直播订阅"
                android:textColor="?attr/skin_text_secondary"
                android:textSize="15sp" />

            <View
                android:id="@+id/tab_live_indicator"
                android:layout_width="36dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="4dp"
                android:background="?attr/skin_accent"
                android:alpha="0" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 内容区 ========== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            tools:listitem="@layout/item_subscription"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_live"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            tools:listitem="@layout/item_subscription"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </FrameLayout>
</LinearLayout>
