<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="?attr/skin_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:paddingHorizontal="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/nameContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:orientation="horizontal">

            <!-- 站点名称不再限制最大宽度，文字完整显示不截断 -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAlignment="gravity"
                android:textColor="?attr/skin_text_primary"
                android:textSize="16dp"
                android:drawablePadding="6dp"
                android:singleLine="true"
                android:ellipsize="none"
                android:drawableRight="@drawable/ic_arrow_down"
                android:focusable="true"
                android:focusableInTouchMode="true"
                />

        </LinearLayout>

        <!-- 占位撑开，让搜索框只占剩余空间的一小部分 -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1.2" />

        <TextView
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:background="@drawable/bg_skin_field"
            android:gravity="center_vertical"
            android:paddingHorizontal="12sp"
            android:hint="搜索"
            android:drawableTint="?attr/skin_text_secondary"
            android:drawableRight="@drawable/ic_search_18"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.angcyo.tablayout.DslTabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:tab_indicator_drawable="@drawable/indicator_flash"
            app:tab_indicator_enable_flash="true"
            app:tab_indicator_enable_flash_clip="true"
            app:tab_indicator_height="5dp"
            app:tab_indicator_width="16dp"
            app:tab_select_color="?attr/skin_accent"
            app:tab_text_min_size="14dp"
            app:tab_text_max_size="16dp"
            app:tab_enable_gradient_text_size="false"
            android:layout_marginTop="6dp"
            >

        </com.angcyo.tablayout.DslTabLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            />
    </LinearLayout>
</LinearLayout>