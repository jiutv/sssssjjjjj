<?xml version="1.0" encoding="utf-8"?>
<!--
    首页沉浸式布局：
    - 内容全屏铺满，首页 Hero 可以延伸到状态栏下方
    - 数据源 / 搜索 / 分类 tab 悬浮在内容之上
    - 其它分类页在 Grid 内部预留顶部内边距，避免内容被顶栏遮挡
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/skin_page_bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/mViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- 悬浮顶栏：数据源 + 搜索 + 分类 tab -->
        <LinearLayout
            android:id="@+id/topOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/topLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:paddingHorizontal="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 品牌胶囊：参考 AVBox 的磨砂玻璃药丸 -->
                <LinearLayout
                    android:id="@+id/nameContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_glass_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAlignment="gravity"
                        android:textColor="?attr/skin_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        android:drawablePadding="6dp"
                        android:drawableRight="@drawable/ic_arrow_down"
                        android:drawableTint="?attr/skin_text_secondary"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:maxWidth="210dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        />

                </LinearLayout>

                <!-- 占位撑开，让搜索按钮保持在右侧 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- 搜索：圆形玻璃按钮 -->
                <TextView
                    android:id="@+id/search"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_glass_field"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="13dp"
                    android:drawableLeft="@drawable/ic_search_18"
                    android:drawablePadding="0dp"
                    android:drawableTint="?attr/skin_text_primary"
                    android:contentDescription="搜索"
                    android:singleLine="true" />

            </LinearLayout>

            <com.angcyo.tablayout.DslTabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:tab_indicator_drawable="@drawable/bg_tab_indicator"
                app:tab_indicator_enable_flash="true"
                app:tab_indicator_enable_flash_clip="true"
                app:tab_indicator_height="4dp"
                app:tab_indicator_width="14dp"
                app:tab_select_color="?attr/skin_accent"
                app:tab_text_min_size="14dp"
                app:tab_text_max_size="16dp"
                app:tab_enable_gradient_text_size="false"
                android:paddingHorizontal="6dp"
                android:layout_marginTop="6dp"
                >

            </com.angcyo.tablayout.DslTabLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
