<?xml version="1.0" encoding="utf-8"?>
<!--
    记录（历史 + 收藏）页面
    1. 顶部标题「记录」+ 右上角刷子一键清空按钮
    2. 顶部 Tab【历史｜收藏】左右并排，样式与「订阅管理」页一致，切换查看历史 / 收藏
    3. 列表卡片样式保持不变（item_record_card：左封面 + 中间标题信息 + 右侧删除按钮）
    4. 空数据时由 LoadSir 的 EmptyCallback（暂无数据）占位，与订阅页一致
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/skin_page_bg"
    android:orientation="vertical">

    <!-- 页面标题栏：标题 + 右上角清空按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="记录"
            android:textColor="?attr/skin_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 右上角刷子：一键清空当前 Tab 的数据 -->
        <ImageView
            android:id="@+id/iv_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="清空"
            android:padding="4dp"
            android:src="@drawable/ic_clear"
            app:tint="?attr/skin_text_secondary" />
    </LinearLayout>

    <!-- 横向均分 Tab：历史 / 收藏（与订阅管理页 Tab 同款样式） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- 历史 Tab -->
        <LinearLayout
            android:id="@+id/tab_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tab_history_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="历史"
                android:textColor="?attr/skin_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/tab_history_indicator"
                android:layout_width="36dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="4dp"
                android:background="?attr/skin_accent" />
        </LinearLayout>

        <!-- 收藏 Tab -->
        <LinearLayout
            android:id="@+id/tab_collect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tab_collect_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="收藏"
                android:textColor="?attr/skin_text_secondary"
                android:textSize="15sp" />

            <View
                android:id="@+id/tab_collect_indicator"
                android:layout_width="36dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="4dp"
                android:alpha="0"
                android:background="?attr/skin_accent" />
        </LinearLayout>
    </LinearLayout>

    <!-- 长按逐条删除的提示（有数据时显示） -->
    <TextView
        android:id="@+id/top_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="6dp"
        android:text="长按条目可逐条删除"
        android:textColor="?attr/skin_text_secondary"
        android:textSize="11sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 当前 Tab 的卡片列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mGridView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_record_card" />

    <include
        android:id="@+id/bottom_nav"
        layout="@layout/view_bottom_nav" />

</LinearLayout>
