<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/skin_page_bg">

    <!-- 详情页背景：本剧封面高斯模糊 -->
    <ImageView
        android:id="@+id/ivDetailBg"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:scaleType="centerCrop"
        android:visibility="invisible"
        tools:visibility="visible" />

    <!-- 背景遮罩：向下渐变过渡到页面底色 -->
    <View
        android:id="@+id/bgScrim"
        android:layout_width="match_parent"
        android:layout_height="380dp" />

    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/previewPlayerPlace"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_40"
            android:paddingRight="@dimen/dp_50"
            android:paddingBottom="@dimen/dp_10">

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <!-- 顶部居中金色 logo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDetailLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.32"
                        android:text="MBox"
                        android:textColor="#D9B36A"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="6dp"
                        android:background="#D9B36A" />
                </LinearLayout>

                <!-- 封面 + 剧集信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="16dp"
                    android:background="?attr/skin_card_bg"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="104dp"
                        android:layout_height="146dp">

                        <ImageView
                            android:id="@+id/ivPoster"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_loading_placeholder" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/ll_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="鬼灭之刃"
                                android:textColor="?attr/skin_text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="8dp"
                                android:text="详情 >>"
                                android:textColor="?attr/skin_text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="?attr/skin_text_secondary"
                            android:textSize="12sp"
                            tools:text="中国大陆 · 2026 · 剧集" />

                        <TextView
                            android:id="@+id/tvDirector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="?attr/skin_text_secondary"
                            android:textSize="12sp"
                            tools:text="导演：杨龙" />

                        <TextView
                            android:id="@+id/tvActor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="?attr/skin_text_secondary"
                            android:textSize="12sp"
                            tools:text="演员：田曦薇，闫桉，刘小北" />

                        <TextView
                            android:id="@+id/tvNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="?attr/skin_accent_soft"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textColor="?attr/skin_accent"
                            android:textSize="11sp"
                            android:visibility="gone"
                            tools:text="更新至 12 集"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSite"
                        android:background="?attr/skin_card_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        tools:text="非凡影视"
                        android:textColor="?attr/skin_text_primary"
                        android:drawableRight="@drawable/ic_change_20"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:id="@+id/iv_private_browsing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:paddingLeft="10dp"
                        android:src="@drawable/ic_private_browsing"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="6dp"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvCast"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_40"
                        android:drawableRight="@drawable/ic_cast_18"
                        android:drawablePadding="6dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="投屏"
                        android:textColor="?attr/skin_text_primary" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:background="?attr/skin_card_border"
                        android:layout_marginHorizontal="6dp"/>
                    <TextView
                        android:id="@+id/tvCollect"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_40"
                        android:drawableRight="@drawable/ic_colloct_18"
                        android:drawablePadding="6dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="收藏"
                        android:textColor="?attr/skin_text_primary" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:background="?attr/skin_card_border"
                        android:layout_marginHorizontal="6dp"/>
                    <TextView
                        android:id="@+id/tvDownload"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_40"
                        android:drawableRight="@drawable/ic_download_18"
                        android:drawablePadding="6dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="下载"
                        android:textColor="?attr/skin_text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/skin_card"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="2dp"/>


                <LinearLayout
                    android:id="@+id/mEmptyPlaylist"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/dp_128"
                        android:layout_height="@dimen/dp_128"
                        android:layout_gravity="center"
                        android:src="@drawable/icon_empty" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dp_10"
                        android:layout_marginLeft="@dimen/dp_10"
                        android:gravity="center"
                        android:text="暂无播放数据"

                        />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/parse_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="解析"
                        android:textColor="?attr/skin_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="14dp"
                        android:layout_marginTop="8dp"
                        android:layout_centerVertical="true"
                        />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_parse"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_select_flag" />
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="线路"
                        android:textColor="?attr/skin_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_centerVertical="true"
                        />
                    <TextView
                        android:id="@+id/tvChangeLine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快捷换线"
                        android:drawableRight="@drawable/ic_change_20"
                        android:textColor="?attr/skin_text_primary"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        android:paddingLeft="20dp"
                        android:layout_alignParentRight="true"
                        />
                </RelativeLayout>
                <!--        线路列表-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mGridViewFlag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="4dp"
                    tools:listitem="@layout/item_select_flag"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:orientation="horizontal"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选集"
                        android:textColor="?attr/skin_text_primary"
                        android:textSize="16sp"
                        android:layout_centerVertical="true"
                        android:textStyle="bold"
                        />

                    <Space
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/tvSort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="倒序"
                        android:drawableRight="@drawable/ic_sort_18"
                        android:textColor="?attr/skin_text_primary"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        />

                    <View
                        android:id="@+id/line10"
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="?attr/skin_card_border" />
                    <TextView
                        android:id="@+id/tv_all_series"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全部"
                        android:drawableRight="@drawable/ic_expand_all_18"
                        android:textColor="?attr/skin_text_primary"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        />
                </LinearLayout>
                <!--        集数列表：网格铺开，全部集数直接显示 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mGridView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_series"/>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/previewPlayer"
        android:layout_width="match_parent"
        android:layout_height="250dp" />

</FrameLayout>
