<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮窗播放器：FrameLayout 尺寸由 WindowManager.LayoutParams 决定，match_parent 让内部子 View 正确填充 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/float_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:fitsSystemWindows="false">

    <!-- 视频 Surface -->
    <android.view.SurfaceView
        android:id="@+id/float_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 顶部操作条（黑色半透明 + 拖拽手柄 + 播放 + 全屏 + 关闭） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <!-- 拖拽手柄 -->
        <ImageView
            android:id="@+id/float_drag"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="拖拽"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#FFFFFF" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- 暂停/播放 -->
        <ImageView
            android:id="@+id/float_play"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="播放"
            android:padding="2dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="#FFFFFF" />

        <!-- 恢复全屏 -->
        <ImageView
            android:id="@+id/float_full"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:contentDescription="全屏"
            android:padding="2dp"
            android:src="@android:drawable/ic_menu_crop"
            app:tint="#FFFFFF" />

        <!-- 关闭悬浮窗 -->
        <ImageView
            android:id="@+id/float_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:contentDescription="关闭"
            android:padding="2dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
