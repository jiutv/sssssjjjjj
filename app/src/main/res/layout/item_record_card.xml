<?xml version="1.0" encoding="utf-8"?>
<!--
    记录页卡片（历史 / 收藏通用）—— 3 列海报网格版
    封面在上、标题信息在下，右上角独立删除按钮，点击/长按逻辑保持不变
    黑金深色主题：卡片背景复用 bg_sub_card（与订阅卡片同款）
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_sub_card"
    android:paddingBottom="8dp">

    <!-- 顶部封面：按 2:3 海报比例铺满卡片宽度 -->
    <ImageView
        android:id="@+id/iv_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="封面"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/img_loading_placeholder" />

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/skin_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_cover"
        tools:text="鬼灭之刃" />

    <!-- 副标题：来源 · 年份 -->
    <TextView
        android:id="@+id/tv_meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/skin_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/tv_name"
        app:layout_constraintStart_toStartOf="@id/tv_name"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        tools:text="金牌 · 2024" />

    <!-- 历史卡片播放进度标记（收藏卡片隐藏） -->
    <TextView
        android:id="@+id/tv_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/skin_accent"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_name"
        app:layout_constraintStart_toStartOf="@id/tv_name"
        app:layout_constraintTop_toBottomOf="@id/tv_meta"
        tools:text="上次看到：第 3 集"
        tools:visibility="visible" />

    <!-- 右上角独立删除按钮（长按整卡也可删除） -->
    <ImageView
        android:id="@+id/iv_del"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="4dp"
        android:background="@drawable/bg_sub_card"
        android:contentDescription="删除"
        android:padding="4dp"
        android:src="@drawable/dkplayer_ic_action_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/red" />

</androidx.constraintlayout.widget.ConstraintLayout>
