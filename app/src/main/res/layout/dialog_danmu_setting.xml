<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:singleLine="true"
                android:text="弹幕设置"
                android:textColor="?attr/skin_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="right|top"
                android:contentDescription="关闭"
                android:padding="10dp"
                android:src="@drawable/ic_close_24"
                app:tint="?attr/skin_text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="弹幕开关"
                    android:textColor="?attr/skin_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/danmu_open"
                    style="@style/DanmuSettingValue"
                    android:text="开" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="弹幕速度"
                    android:textColor="?attr/skin_text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/speedSub"
                    style="@style/DanmuSettingStep"
                    android:text="-" />

                <TextView
                    android:id="@+id/speed"
                    style="@style/DanmuSettingValue"
                    android:text="1.5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/speedAdd"
                    style="@style/DanmuSettingStep"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="字体大小"
                    android:textColor="?attr/skin_text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sizeSub"
                    style="@style/DanmuSettingStep"
                    android:text="-" />

                <TextView
                    android:id="@+id/size"
                    style="@style/DanmuSettingValue"
                    android:text="0.8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sizeAdd"
                    style="@style/DanmuSettingStep"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="透明度"
                    android:textColor="?attr/skin_text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/alphaSub"
                    style="@style/DanmuSettingStep"
                    android:text="-" />

                <TextView
                    android:id="@+id/alpha"
                    style="@style/DanmuSettingValue"
                    android:text="90%" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/alphaAdd"
                    style="@style/DanmuSettingStep"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="最大行数"
                    android:textColor="?attr/skin_text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lineSub"
                    style="@style/DanmuSettingStep"
                    android:text="-" />

                <TextView
                    android:id="@+id/line"
                    style="@style/DanmuSettingValue"
                    android:text="3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lineAdd"
                    style="@style/DanmuSettingStep"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="随机颜色"
                    android:textColor="?attr/skin_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/randomColor"
                    style="@style/DanmuSettingValue"
                    android:text="关" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/danmuSearch"
                style="@style/mbSolid"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:text="搜索弹幕"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/danmuReset"
                style="@style/mbOutline"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="恢复默认"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
