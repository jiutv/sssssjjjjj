<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.lihang.ShadowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        app:hl_cornerRadius="10dp"
        app:hl_layoutBackground="#6632364E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:text="弹幕设置"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="弹幕开关"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/danmu_open"
                    style="@style/DanmuSettingValue"
                    android:text="开" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="弹幕速度"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/speedSub"
                    style="@style/DanmuSettingStep"
                    android:text="-" />

                <TextView
                    android:id="@+id/speed"
                    style="@style/DanmuSettingValue"
                    android:text="1.5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/speedAdd"
                    style="@style/DanmuSettingStep"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="字体大小"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sizeSub"
                    style="@style/DanmuSettingStep"
                    android:text="-" />

                <TextView
                    android:id="@+id/size"
                    style="@style/DanmuSettingValue"
                    android:text="0.8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sizeAdd"
                    style="@style/DanmuSettingStep"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="透明度"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/alphaSub"
                    style="@style/DanmuSettingStep"
                    android:text="-" />

                <TextView
                    android:id="@+id/alpha"
                    style="@style/DanmuSettingValue"
                    android:text="90%" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/alphaAdd"
                    style="@style/DanmuSettingStep"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="最大行数"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lineSub"
                    style="@style/DanmuSettingStep"
                    android:text="-" />

                <TextView
                    android:id="@+id/line"
                    style="@style/DanmuSettingValue"
                    android:text="3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lineAdd"
                    style="@style/DanmuSettingStep"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="随机颜色"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/randomColor"
                    style="@style/DanmuSettingValue"
                    android:text="关" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/danmuSearch"
                style="@style/mbSolid"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:text="搜索弹幕"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/danmuReset"
                style="@style/mbOutline"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="恢复默认"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </com.lihang.ShadowLayout>
</FrameLayout>
