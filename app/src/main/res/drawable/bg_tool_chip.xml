<?xml version="1.0" encoding="utf-8"?>
<!--
  详情页工具按钮胶囊（投屏/收藏/下载）—— 玻璃半透明 + 细描边
  按下态用 transparent 让 ripple 接管（item_bg_selector_* 已做）
