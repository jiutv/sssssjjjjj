<?xml version="1.0" encoding="utf-8"?>
<!--
  线路 tab 胶囊 — 选中态
  skin_accent_soft 填充 + skin_accent 描边，柔和强调
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/skin_accent_soft" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/skin_accent" />
</shape>
