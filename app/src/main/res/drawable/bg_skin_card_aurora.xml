<?xml version="1.0" encoding="utf-8"?>
<!-- 方案4 卡片：半透明蓝紫 + 18dp 圆角 + 霓虹描边 + 蓝紫光晕 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/skin_aurora_card" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/skin_aurora_border" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#268C7BFF"
                android:centerColor="#0D8C7BFF"
                android:endColor="#008C7BFF" />
        </shape>
    </item>
</layer-list>
