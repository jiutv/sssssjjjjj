<?xml version="1.0" encoding="utf-8"?>
<!-- 方案3 卡片：深青实色 + 14dp 圆角 + 青色细描边 + 左上渐变点缀 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/skin_tech_card" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/skin_tech_border" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="315"
                android:startColor="#1A2BE3C8"
                android:endColor="#002BE3C8" />
        </shape>
    </item>
</layer-list>
