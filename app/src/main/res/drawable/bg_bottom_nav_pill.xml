<?xml version="1.0" encoding="utf-8"?>
<!-- 底部导航玻璃胶囊：半透明页面色（露出后方内容）+ 顶部高光 + 细描边，跟随皮肤 token -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 半透明底色：使用皮肤页面色，让下方海报/列表透出，形成磨砂玻璃感 -->
    <item android:alpha="0.82">
        <shape android:shape="rectangle">
            <solid android:color="?attr/skin_page" />
            <corners android:radius="@dimen/bottom_nav_radius" />
            <stroke
                android:width="1dp"
                android:color="?attr/skin_card_border" />
        </shape>
    </item>
    <!-- 顶部白色高光：模拟玻璃受光面 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#1FFFFFFF"
                android:type="linear" />
            <corners android:radius="@dimen/bottom_nav_radius" />
        </shape>
    </item>
</layer-list>
