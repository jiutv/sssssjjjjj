<?xml version="1.0" encoding="utf-8"?>
<!-- 方案1 深色磨砂满天星：深黑渐变 + 顶部柔光 -->
<!-- 去掉 <bitmap tileMode> 以兼容部分机型（三星 Android 13 等）InflateException -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0B0E16"
                android:centerColor="#080A10"
                android:endColor="#050609" />
        </shape>
    </item>

    <!-- 顶部柔光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="520dp"
                android:startColor="#1FFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

</layer-list>
