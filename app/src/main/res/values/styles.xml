<resources>


    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!--应用的主要色调,actionBar默认使用该颜色,Toolbar导航栏的底色-->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!--CheckBox,RadioButton,SwitchCompat等一般控件的选中效果默认采用该颜色-->
        <item name="colorAccent">@color/colorAccent</item>
        <!--默认window窗口(activity)背景颜色,根据主题修改该属性可 避免某些情况activity跳转/回跳会白屏(出现与主题相反的颜色)-->
        <item name="android:windowBackground">@color/windowBackground</item>

        <!-- 默认皮肤 token（不选皮肤时保持 APP 原有深色风格） -->
        <item name="skin_page">@color/windowBackground</item>
        <item name="skin_card">@color/bg_popup</item>
        <item name="skin_card_border">@color/skin_default_border</item>
        <item name="skin_text_primary">@color/text_foreground</item>
        <item name="skin_text_secondary">@color/text_sub_foreground</item>
        <item name="skin_accent">@color/title_fouse_n</item>
        <item name="skin_accent_soft">@color/skin_default_accent_soft</item>
        <item name="skin_on_accent">@color/white</item>
        <item name="skin_glow">@color/skin_default_accent_soft</item>
        <item name="skin_page_bg">@drawable/bg_skin_page_default</item>
        <item name="skin_card_bg">@drawable/bg_large_round_gray</item>
    </style>

    <!-- ===================================================================
         主题方案 1：深色磨砂满天星
         主色 #06070B 深黑 / #FFFFFF 白
         毛玻璃半透明卡片，大圆角，选中项白色柔光
         =================================================================== -->
    <style name="SkinStarry" parent="AppTheme">
        <item name="android:windowBackground">@color/skin_starry_page</item>
        <item name="skin_page">@color/skin_starry_page</item>
        <item name="skin_page_bg">@drawable/bg_skin_page_starry</item>
        <item name="skin_card">@color/skin_starry_card</item>
        <item name="skin_card_bg">@drawable/bg_skin_card_starry</item>
        <item name="skin_card_border">@color/skin_starry_border</item>
        <item name="skin_text_primary">@color/skin_starry_text</item>
        <item name="skin_text_secondary">@color/skin_starry_text_2</item>
        <item name="skin_accent">@color/skin_starry_accent</item>
        <item name="skin_accent_soft">@color/skin_starry_accent_soft</item>
        <item name="skin_on_accent">@color/skin_starry_on_accent</item>
        <item name="skin_glow">@color/skin_starry_glow</item>
        <item name="colorAccent">@color/skin_starry_accent</item>
        <item name="colorPrimary">@color/skin_starry_accent</item>
    </style>

    <!-- ===================================================================
         主题方案 2：黑金凤雅
         主色 #080604 深黑 / #D9B36A 香槟金
         金色描边与按钮，实色卡片，10dp 克制圆角
         =================================================================== -->
    <style name="SkinGold" parent="AppTheme">
        <item name="android:windowBackground">@color/skin_gold_page</item>
        <item name="skin_page">@color/skin_gold_page</item>
        <item name="skin_page_bg">@drawable/bg_skin_page_gold</item>
        <item name="skin_card">@color/skin_gold_card</item>
        <item name="skin_card_bg">@drawable/bg_skin_card_gold</item>
        <item name="skin_card_border">@color/skin_gold_border</item>
        <item name="skin_text_primary">@color/skin_gold_text</item>
        <item name="skin_text_secondary">@color/skin_gold_text_2</item>
        <item name="skin_accent">@color/skin_gold_accent</item>
        <item name="skin_accent_soft">@color/skin_gold_accent_soft</item>
        <item name="skin_on_accent">@color/skin_gold_on_accent</item>
        <item name="skin_glow">@color/skin_gold_glow</item>
        <item name="colorAccent">@color/skin_gold_accent</item>
        <item name="colorPrimary">@color/skin_gold_accent</item>
    </style>

    <!-- ===================================================================
         主题方案 3：青黑科技
         主色 #04100E 深黑 / #2BE3C8 孔雀绿
         青色渐变点缀，14dp 圆角，选中青色柔光
         =================================================================== -->
    <style name="SkinTech" parent="AppTheme">
        <item name="android:windowBackground">@color/skin_tech_page</item>
        <item name="skin_page">@color/skin_tech_page</item>
        <item name="skin_page_bg">@drawable/bg_skin_page_tech</item>
        <item name="skin_card">@color/skin_tech_card</item>
        <item name="skin_card_bg">@drawable/bg_skin_card_tech</item>
        <item name="skin_card_border">@color/skin_tech_border</item>
        <item name="skin_text_primary">@color/skin_tech_text</item>
        <item name="skin_text_secondary">@color/skin_tech_text_2</item>
        <item name="skin_accent">@color/skin_tech_accent</item>
        <item name="skin_accent_soft">@color/skin_tech_accent_soft</item>
        <item name="skin_on_accent">@color/skin_tech_on_accent</item>
        <item name="skin_glow">@color/skin_tech_glow</item>
        <item name="colorAccent">@color/skin_tech_accent</item>
        <item name="colorPrimary">@color/skin_tech_accent</item>
    </style>

    <!-- ===================================================================
         主题方案 4：蓝紫沉浸
         主色 #0A0A1C 深靛蓝 / #8C7BFF 蓝紫
         渐变背景 + 毛玻璃卡片，18dp 圆角，霓虹描边与光晕
         =================================================================== -->
    <style name="SkinAurora" parent="AppTheme">
        <item name="android:windowBackground">@color/skin_aurora_page</item>
        <item name="skin_page">@color/skin_aurora_page</item>
        <item name="skin_page_bg">@drawable/bg_skin_page_aurora</item>
        <item name="skin_card">@color/skin_aurora_card</item>
        <item name="skin_card_bg">@drawable/bg_skin_card_aurora</item>
        <item name="skin_card_border">@color/skin_aurora_border</item>
        <item name="skin_text_primary">@color/skin_aurora_text</item>
        <item name="skin_text_secondary">@color/skin_aurora_text_2</item>
        <item name="skin_accent">@color/skin_aurora_accent</item>
        <item name="skin_accent_soft">@color/skin_aurora_accent_soft</item>
        <item name="skin_on_accent">@color/skin_aurora_on_accent</item>
        <item name="skin_glow">@color/skin_aurora_glow</item>
        <item name="colorAccent">@color/skin_aurora_accent</item>
        <item name="colorPrimary">@color/skin_aurora_accent</item>
    </style>

    <!-- ===================================================================
         主题方案 5：暖橙怀旧
         主色 #14100B 深棕黑 / #FF8A4C 暖橙
         胶片颗粒 + 复古 12dp 圆角，橙红按钮与暖橙高亮
         =================================================================== -->
    <style name="SkinRetro" parent="AppTheme">
        <item name="android:windowBackground">@color/skin_retro_page</item>
        <item name="skin_page">@color/skin_retro_page</item>
        <item name="skin_page_bg">@drawable/bg_skin_page_retro</item>
        <item name="skin_card">@color/skin_retro_card</item>
        <item name="skin_card_bg">@drawable/bg_skin_card_retro</item>
        <item name="skin_card_border">@color/skin_retro_border</item>
        <item name="skin_text_primary">@color/skin_retro_text</item>
        <item name="skin_text_secondary">@color/skin_retro_text_2</item>
        <item name="skin_accent">@color/skin_retro_accent</item>
        <item name="skin_accent_soft">@color/skin_retro_accent_soft</item>
        <item name="skin_on_accent">@color/skin_retro_on_accent</item>
        <item name="skin_glow">@color/skin_retro_glow</item>
        <item name="colorAccent">@color/skin_retro_accent</item>
        <item name="colorPrimary">@color/skin_retro_accent</item>
    </style>

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>//全屏即无通知栏
        <item name="android:windowContentOverlay">@null</item>//是否有遮盖
        <item name="windowNoTitle">true</item>
        <item name="android:keepScreenOn">true</item>
        <!--        <item name="android:windowBackground">@drawable/main_bg</item>-->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <!-- 自定义dialog样式 -->
    <style name="CustomDialogStyle" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="CustomDialogStyleDim" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="epg_window_btn">
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/item_bg_selector_right</item>
        <item name="android:paddingLeft">0dip</item>
        <item name="android:paddingRight">0dip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:drawablePadding">10.0dip</item>
        <item name="android:radius">10dp</item>
    </style>

    <style name="BottomDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <style name="DialogFadeAnimation">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <style name="TabVerticalItemStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16dp</item>
    </style>


    <!-- 实心通用主题色,MaterialButton样式-->
    <style name="mbSolid" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">

        <item name="android:textColor">?attr/skin_on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="backgroundTintMode">src_atop</item>
        <item name="backgroundTint">?attr/skin_accent</item>
        <!--        <item name="rippleColor">@color/white</item>-->

        <item name="iconTintMode">src_atop</item>
        <item name="iconTint">?attr/skin_on_accent</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <!--        <item name="iconSize">20dp</item>-->

        <item name="cornerRadius">@dimen/common_corners</item>
    </style>

    <!-- 弹幕设置数值 -->
    <style name="DanmuSettingValue">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- 弹幕设置步进按钮 -->
    <style name="DanmuSettingStep" parent="mbSolid">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 带边框的空心MaterialButton样式-->
    <style name="mbOutline" parent="@style/Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">?attr/skin_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <!--        <item name="rippleColor">@color/white</item>-->
        <!--        <item name="strokeWidth">1dp</item>-->
        <item name="strokeColor">?attr/skin_accent</item>
        <item name="cornerRadius">@dimen/common_corners</item>
        <!--        <item name="iconTintMode">src_atop</item>-->
        <!--        <item name="iconTint">@color/white</item>-->
        <!--        <item name="iconGravity">textStart</item>-->
        <!--        <item name="iconPadding">0dp</item>-->
        <!--        <item name="iconSize">20dp</item>-->

    </style>

<!--文件选择器样式,在此只改变了背景和基本颜色-->
    <style name="FileChooser" parent="FileChooserStyle">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textColorPrimary">@color/colorPrimary</item>
        <item name="android:textColorSecondary">@color/colorPrimary</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimary</item>
        <item name="colorAccent">@color/material_deep_teal_200</item>
        <item name="fileChooserDialogStyle">@style/FileChooserDialogStyle1</item>
        <item name="fileChooserListItemStyle">@style/FileChooserListItemStyle1</item>
        <item name="fileChooserPathViewStyle">@style/FileChooserPathViewStyle1</item>
    </style>

<!--选择器弹窗样式-->
    <style name="FileChooserDialogStyle1" parent="FileChooserDialogStyle">
        <item name="android:windowBackground">@drawable/bg_large_round_popup</item>
        <item name="android:buttonBarButtonStyle">@style/FileChooserButtonStyle1</item>
        <item name="buttonBarButtonStyle">@style/FileChooserButtonStyle1</item>
    </style>
    <style name="FileChooserButtonStyle1" parent="FileChooserButtonStyle">
        <item name="android:textColor">@color/black</item>
    </style>
<!--    选择器弹窗样式结束-->

<!--文件选择器条目样式开始-->
    <style name="FileChooserListItemStyle1" parent="FileChooserListItemStyle">
        <item name="fileChooserTextNameStyle">@style/FileChooserTextNameStyle1</item>
        <item name="fileChooserTextSizeStyle">@style/FileChooserTextSizeStyle1</item>
        <item name="fileChooserTextDateStyle">@style/FileChooserTextDateStyle1</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="FileChooserTextNameStyle1" parent="FileChooserTextNameStyle">
        <item name="android:textColor">@color/text_foreground</item>
    </style>
    <style name="FileChooserTextSizeStyle1" parent="FileChooserTextSizeStyle">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>
    <style name="FileChooserTextDateStyle1" parent="FileChooserTextDateStyle">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>
<!--    文件选择器条目样式结束-->

    <!-- 选择器文件路径样式   -->
    <style name="FileChooserPathViewStyle1" parent="FileChooserPathViewStyle">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/text_foreground</item>
    </style>


</resources>
