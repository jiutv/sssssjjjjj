        <item name="colorAccent">@color/skin_liquid_accent</item>
        <item name="colorPrimary">@color/skin_liquid_accent</item>
    </style>

    <!-- ===================================================================
         主题方案 6：樱花粉（Sakura）
         深玫瑰黑底 + #FF7AA8 樱花粉，半透明玻璃卡片 + 粉色描边光晕
         =================================================================== -->
    <style name="SkinPink" parent="AppTheme">
        <item name="android:windowBackground">@color/skin_pink_page</item>
        <item name="skin_page">@color/skin_pink_page</item>
        <item name="skin_page_bg">@drawable/bg_skin_page_pink</item>
        <item name="skin_card">@color/skin_pink_card</item>
        <item name="skin_card_bg">@drawable/bg_skin_card_liquid</item>
        <item name="skin_card_border">@color/skin_pink_border</item>
        <item name="skin_text_primary">@color/skin_pink_text</item>
        <item name="skin_text_secondary">@color/skin_pink_text_2</item>
