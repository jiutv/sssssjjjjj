        <item name="skin_page">@color/skin_liquid_page</item>
        <item name="skin_page_bg">@drawable/bg_skin_page_liquid</item>
        <item name="skin_card">@color/skin_liquid_card</item>
        <item name="skin_card_bg">@drawable/bg_skin_card_liquid</item>
